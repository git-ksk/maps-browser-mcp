# Example configuration only.
# maps-browser-mcp does NOT automatically load this file.
# Export variables in your shell or load them with your process manager/environment tooling.
# Never commit real tokens, credentials, browser profiles, or machine-specific private values.

# HTTP transport
# Recommended: keep the Node server on loopback and put an authenticated HTTPS
# tunnel/reverse proxy in front when a remote MCP client needs access.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
# If MCP_HTTP_PORT is unset, the generic PORT variable is accepted as a fallback.
# PORT=8787
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Optional exact Origin allowlist, comma-separated as supported by the server.
# MCP_ALLOWED_ORIGINS=https://example-client.invalid

# HTTP authentication
# none (default) keeps local/stdio behavior unchanged.
# static-bearer preserves the legacy single-user transport guard.
# module loads an explicit adapter exporting createAuthProvider(); the adapter returns
# a stable authenticated { subject, email? } principal to the core runtime.
# MCP_AUTH_PROVIDER=none
# MCP_AUTH_PROVIDER=static-bearer
# MCP_BEARER_TOKEN=replace-with-a-long-random-token-at-least-24-chars
# MCP_AUTH_PROVIDER=module
# MCP_AUTH_PROVIDER_MODULE=file:///absolute/path/to/auth-provider.mjs
#
# Do not combine module auth with MCP_BEARER_TOKEN because both consume Authorization.
# Non-loopback bind requires MCP_ALLOW_NONLOOPBACK=true plus an auth provider.
# MCP_ALLOW_NONLOOPBACK=true
MCP_MAX_BODY_BYTES=262144

# V2.1 remote/mobile human takeover (disabled by default)
# The Node process MUST remain loopback-bound. Put an authenticated HTTPS gateway/tunnel
# in front of it. /mcp and /takeover/* are authenticated by the same provider inside Node,
# and the takeover capability is bound to the principal that originated the MCP handoff.
# Do not expose the Node takeover broker or CDP port directly to the network.
#
# MAPS_TAKEOVER_PUBLIC_BASE_URL must be the externally visible HTTPS origin only:
# no credentials, path, query, or fragment. Add its hostname to MCP_ALLOWED_HOSTS if
# your reverse proxy preserves the public Host header when forwarding to this process.
# MAPS_REMOTE_TAKEOVER=true
# MAPS_TAKEOVER_PUBLIC_BASE_URL=https://maps-mcp.example.com
# MAPS_TAKEOVER_TTL_SECONDS=300

# Credential-safe Human handoff for identity-sensitive Google surfaces only
# (sign-in, consent, CAPTCHA/access challenge). Passkeys/WebAuthn remain Human/provider controlled.
#
# Local/Mac ownership: stop managed CDP Chrome, open the same dedicated profile in normal
# Chrome, then use either an existing OS-level remote-access product (default) or the local
# Cua-backed Human Takeover UI. Cua is optional; Maps is not coupled to it.
# MAPS_CREDENTIAL_SAFE_HANDOFF=true
# MAPS_CREDENTIAL_SAFE_TRANSPORT=external
# MAPS_CREDENTIAL_SAFE_OPERATOR_URL=https://remote-access.example.com/
# Linux/Cloud Run must use the same normal-browser boundary as macOS: stop the
# automation browser, reopen the dedicated profile in a normal browser with no
# remote-debugging/automation authority, then use a Linux capture/input host behind
# Handoff WebRTC. That Linux host is not implemented yet. Legacy hosted_cdp remains
# parseable for rollout compatibility but Human credential/consent/challenge steps fail closed.
# Legacy rollout compatibility only; do not use for Human credential/consent/challenge:
# MAPS_CREDENTIAL_SAFE_TRANSPORT=hosted_cdp
# Optional deployment-only hook invoked only after fresh signed-in verification and
# a clean browser stop. The reference OAuth entrypoint wires this automatically when
# MAPS_PROFILE_SNAPSHOT_BUCKET is configured.
# MAPS_BROWSER_STOPPED_CHECKPOINT_MODULE=/app/reference/oauth-gateway/profile-checkpoint-provider.mjs
# For the Cua-backed local option, Remote Takeover must also be enabled and authenticated:
# MAPS_CREDENTIAL_SAFE_TRANSPORT=cua_takeover
# MAPS_CUA_DRIVER_COMMAND=/absolute/path/to/cua-driver
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,maps-mcp.example.com
#
# Built-in credential-safe mobile takeover on a co-located macOS host.
# Full setup: docs/webrtc-human-takeover.md (Japanese: docs/webrtc-human-takeover.ja.md).
# `webrtc_takeover` is the recommended built-in path and has passed physical iPhone Safari
# acceptance over same-LAN direct WebRTC and cellular TURN relay. Remote Takeover must be
# authenticated; the Handoff helper owns capture/input/ICE/TURN details.
# MAPS_CREDENTIAL_SAFE_HANDOFF=true
# MAPS_CREDENTIAL_SAFE_TRANSPORT=webrtc_takeover
# MAPS_REMOTE_TAKEOVER=true
# MAPS_TAKEOVER_PUBLIC_BASE_URL=https://maps-mcp.example.com
# MAPS_WEBRTC_TAKEOVER_HOST_EXECUTABLE=/absolute/path/to/platform-webrtc-host  # Linux: node_modules/.bin/handoff-linux-webrtc-host
# Linux only: local isolated X11 display used by the normal-browser helper.
# MAPS_WEBRTC_TAKEOVER_DISPLAY_NAME=:99
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,maps-mcp.example.com
#
# Native `thin_takeover` remains optional/experimental until its separate physical app
# acceptance is complete. It requires the Handoff Native host/revoke executables plus explicit
# reviewed network/bind settings; do not treat it as a generic Cloud/container transport.
# MAPS_CREDENTIAL_SAFE_TRANSPORT=thin_takeover
# MAPS_NATIVE_TAKEOVER_HOST_EXECUTABLE=/absolute/path/to/takeover-macos-host
# MAPS_NATIVE_TAKEOVER_REVOKE_EXECUTABLE=/absolute/path/to/takeover-control-send
# MAPS_NATIVE_TAKEOVER_ADVERTISED_HOST=192.0.2.10
#
# `external` remains the configuration default for backward-compatible fail-closed deployment.
# CAPTCHA, MFA, consent, and passkey ceremonies remain Human-only and are never bypassed.
# For a real user identity, use the documented authenticated gateway shape. The current V5
# runtime still rejects multi-principal module auth until per-principal browser isolation exists.

# Execution Handoff V3 durable recovery metadata (disabled by default)
# Configure BOTH values to persist only a signed control-plane checkpoint while Human
# intervention is active. Raw Maps queries, locations, browser text, credentials,
# CAPTCHA/2FA values, cookies, approval receipts, and raw action arguments are not saved.
# The file path must be absolute. The key must be exactly 32 random bytes encoded as
# canonical unpadded base64url and must remain stable across process restarts.
# Example key generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MAPS_HANDOFF_CHECKPOINT_FILE=/absolute/private/path/handoff-checkpoint.json
# MAPS_HANDOFF_CHECKPOINT_KEY=replace-with-32-random-bytes-as-base64url
# MAPS_HANDOFF_CHECKPOINT_TTL_SECONDS=900
#
# Recovery is conservative: after restart the same principal may reissue the same Maps
# action; the checkpoint is matched by action digest and then consumed. The action starts
# again from its validated inputs. Stale Agent/Human authority, DOM state, and old MCP
# requestState are never restored from disk.

# MCP Apps inline Google Maps directions view (optional)
# maps_render_directions always returns text + structured route data. When this key is
# configured, the server additionally advertises/links the display-only MCP Apps UI resource.
# The key is delivered to the sandboxed UI because Google Maps Embed API uses it client-side;
# use a dedicated key restricted to Maps Embed API plus an application restriction that is
# validated for the actual host/referrer environment. Never weaken restrictions just for portability.
# GOOGLE_MAPS_EMBED_API_KEY=replace-with-a-restricted-maps-embed-api-key

# Browser runtime
# The process owns one dedicated Chrome/Chromium process/profile on both Mac and container paths.
# Use a dedicated Chrome/Chromium profile. Do not point this at your everyday profile.
# MAPS_CHROME_EXECUTABLE=/path/to/chrome
# MAPS_CHROME_PROFILE_DIR=/path/to/dedicated/profile
MAPS_HEADLESS=false

# Last-resort compatibility for isolated Linux runtimes that prohibit Chromium's
# namespace sandbox. Disabled by default and never enabled automatically.
# WARNING: this adds Chromium's --no-sandbox flag and removes an important layer
# of browser isolation. Use only in a dedicated, isolated, single-user runtime.
# MAPS_ALLOW_UNSANDBOXED_CHROMIUM=false

# Advanced only: both values are required to attach to an existing local CDP endpoint.
# Only attach to a dedicated Chrome/Chromium instance you control.
# NEVER expose a Chrome DevTools/CDP port to the public internet.
# MAPS_ALLOW_EXTERNAL_CDP=true
# MAPS_CDP_PORT=9222

# Browser-operation safety
MAPS_MAX_ACTIONS_PER_MINUTE=30
MAPS_MAX_PENDING_ACTIONS=8
MAPS_OPERATION_TIMEOUT_MS=25000

# V3 limited visible-state reading (disabled by default)
# Maps-derived text is external/untrusted data and should never be treated as instructions.
INTERACTIVE_ASSIST_MODE=false

# V5 authenticated Google Maps Web workflows (disabled by default)
# This opt-in enables the bounded V5-A through V5-D authenticated workflows documented in
# docs/v5-authenticated-workflows.md. V5 requires Interactive Assist, the server-owned dedicated
# profile, and a single-user
# principal shape. Existing-CDP attachment and module auth are rejected for now because
# per-principal browser/profile isolation is not yet implemented. A remote single-user OAuth
# gateway may authenticate the public client and use the private static-bearer hop to this core.
# MAPS_V5_AUTHENTICATED_WORKFLOWS=true

MAPS_MAX_VISIBLE_READS_PER_HOUR=30
MAPS_MAX_AX_NODES=120
MAPS_MAX_READ_CHARS=1800
