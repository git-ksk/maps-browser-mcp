{
  "name": "maps-browser-mcp",
  "version": "0.3.2",
  "description": "A lightweight MCP server for interacting with Google Maps through a dedicated browser session.",
  "type": "module",
  "bin": {
    "maps-browser-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    ".env.example",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "CHANGELOG.ja.md",
    "SECURITY.md",
    "SECURITY.ja.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "e2e:live:maps": "node scripts/live-maps-e2e.mjs",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "chrome-remote-interface": "0.34.0",
    "mcp-execution-handoff": "https://github.com/git-ksk/mcp-execution-handoff/archive/0fdb22e632384b0f02c9bb141c3aab9ddea98042.tar.gz",
    "steel-sdk": "0.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "0.34.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-maps",
    "browser-automation",
    "chromium",
    "cdp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-ksk/maps-browser-mcp.git"
  },
  "homepage": "https://github.com/git-ksk/maps-browser-mcp#readme",
  "bugs": {
    "url": "https://github.com/git-ksk/maps-browser-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
