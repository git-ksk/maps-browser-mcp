{
  "name": "maps-browser-mcp",
  "version": "0.1.0",
  "description": "A lightweight MCP server for interacting with Google Maps through a dedicated browser session.",
  "type": "module",
  "bin": {
    "maps-browser-mcp": "./dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "chrome-remote-interface": "0.34.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "0.34.0",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-maps",
    "browser-automation",
    "chromium",
    "cdp"
  ],
  "license": "MIT"
}
