PORT=8080
MCP_PUBLIC_BASE_URL=https://maps-mcp-new.example.com
MCP_OAUTH_ALLOWED_CLIENT_HOSTS=chatgpt.com
MCP_OAUTH_MAX_REQUESTS_PER_MINUTE=60
MCP_OAUTH_TRANSACTION_SECRET=replace-from-secret-manager

MCP_FIREBASE_PROJECT_ID=replace-me
# Prefer the immutable UID for a shared MCP Runtime identity:
MCP_FIREBASE_ALLOWED_UID=replace-me
# Email is supported for single-user deployments, but never configure both:
# MCP_FIREBASE_ALLOWED_EMAIL=replace-me@example.com
MCP_FIREBASE_WEB_API_KEY=replace-me

MCP_CORE_URL=http://127.0.0.1:8081/mcp
MCP_CORE_BEARER_TOKEN=replace-from-secret-manager

# Remote/mobile Thin Takeover. Keep the operator secret separate from the OAuth transaction secret.
# The public takeover origin must be this same authenticated gateway origin.
# MAPS_REMOTE_TAKEOVER=true
# MAPS_TAKEOVER_PUBLIC_BASE_URL=https://maps-mcp-new.example.com
# MCP_TAKEOVER_OPERATOR_SECRET=replace-with-an-independent-32-byte-secret
# MCP_TAKEOVER_OPERATOR_SESSION_SECONDS=900
# MAPS_CREDENTIAL_SAFE_HANDOFF=true
# MAPS_CREDENTIAL_SAFE_TRANSPORT=thin_takeover

# Enable only for the controlled V5 acceptance environment / disposable dedicated profile.
# INTERACTIVE_ASSIST_MODE=true
# MAPS_V5_AUTHENTICATED_WORKFLOWS=true

# Optional Cloud Run durable signed-in Chrome profile snapshot.
# The live Chrome profile stays on local ephemeral storage; only stopped-profile archives are stored in GCS.
# MAPS_PROFILE_SNAPSHOT_BUCKET=replace-with-private-bucket
# MAPS_PROFILE_SNAPSHOT_PREFIX=maps-browser-mcp/profile
# MAPS_PROFILE_SNAPSHOT_REQUIRED=false
# MAPS_PROFILE_SNAPSHOT_MAX_BYTES=268435456
# MAPS_PROFILE_SNAPSHOT_KEEP=2
